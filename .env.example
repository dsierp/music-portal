# Baza danych.
# Najprościej (bez Dockera i bez instalowania Postgresa): zostaw puste → PGlite, Postgres w pliku ./data/pglite.
# Prawdziwy Postgres (docker compose up -d / Homebrew / Neon): DATABASE_URL="postgresql://portal:portal@localhost:5432/portal"
DATABASE_URL=""

# Auth.js — wygeneruj: npx auth secret
AUTH_SECRET="change-me"
# Zostaw puste — adres wykrywany automatycznie z zapytania (trustHost). Ustaw tylko na realnej domenie produkcyjnej.
AUTH_URL=""

# Dostawcy logowania — ustaw tylko tych, których chcesz włączyć.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/common/v2.0"
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""
AUTH_FACEBOOK_ID=""
AUTH_FACEBOOK_SECRET=""

# Logowanie deweloperskie (bez OAuth): wpisujesz sam e-mail. NIGDY nie włączaj na produkcji.
AUTH_DEV_LOGIN="true"

# MusicBrainz wymaga identyfikacji aplikacji w User-Agent.
MUSICBRAINZ_USER_AGENT="MusicPortal/0.1 (sierpowski_d@tfs.pl)"

# Opcjonalnie: Discogs (uzupełnienie składów). Bez tokena — pomijane.
DISCOGS_TOKEN=""
